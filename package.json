{
  "name": "queue-management",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath scripts/hooks || true",
    "dev": "pnpm --filter @qm/web dev",
    "build": "pnpm -r --if-present build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p tests/e2e && tsc -p tests/concurrency",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:core": "playwright test --grep @core --project=desktop-chrome",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:e2e:pilot": "playwright test --config playwright.pilot.config.ts",
    "test:functions": "bash scripts/test-functions.sh",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema api --schema app > packages/db-types/src/database.types.ts",
    "test:db": "node scripts/compile-rls-matrix.mjs && supabase test db",
    "test:concurrency": "vitest run --config tests/concurrency/vitest.config.ts",
    "gen:consent": "node scripts/gen-consent.ts",
    "db:compile-tests": "node scripts/compile-rls-matrix.mjs",
    "ci:local": "bash scripts/ci-local.sh",
    "openapi:v1": "node scripts/export-openapi.ts",
    "simulate:day": "node scripts/simulate-day.ts",
    "test:selfhost": "bats deploy/selfhost/tests && bash deploy/selfhost/tests/check-compose.sh"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "playwright-core": "1.63.0",
    "@supabase/supabase-js": "2.118.0",
    "@types/node": "^26.6.6",
    "bats": "^1.13.0",
    "deno": "2.9.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "fake-indexeddb": "^6.2.7",
    "globals": "^17.14.0",
    "jsqr": "1.4.0",
    "postgres": "^4.0.0",
    "prettier": "^3.9.10",
    "supabase": "3.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
