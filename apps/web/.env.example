# Copy to apps/web/.env.local. Values for the local stack come from `pnpm exec supabase status`.
# Only public values belong here: the API URL and the anon (publishable) key. Never the service role key.
VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_ANON_KEY=
# Web push (optional): the VAPID *public* key, the pair of VAPID_PRIVATE_KEY in the dispatcher's
# secrets. Leave empty to hide "Alert me" on the status page.
VITE_VAPID_PUBLIC_KEY=
# Telegram (optional): the bot's public username, matching the telegram_bot_username Vault secret
# (docs/ops/telegram.md). Leave empty to hide "Get updates on Telegram".
VITE_TELEGRAM_BOT=
# Error reports (optional): a Sentry or GlitchTip DSN. Leave empty to send nothing.
# Events are scrubbed of contact data and guest tokens first (lib/sentry.ts).
VITE_SENTRY_DSN=
# The address guests use (e.g. https://queue.example.com), printed on QR posters. Leave empty to
# use the address the admin opened the poster from.
VITE_PUBLIC_URL=
# Cloudflare Turnstile *site* key for sign-in, sign-up and sign-in links (public; the secret goes
# to Supabase Auth, never here). Leave empty locally. Set it before turning on Auth's CAPTCHA, or
# nobody can sign in: docs/ops/pilot-deploy.md.
VITE_AUTH_TURNSTILE_SITE_KEY=

# Your own Terms page, privacy notice and support inbox. Nothing is built in: left unset, the app
# shows no legal links and no "Contact support" form. The self-host image ignores these and reads
# TERMS_URL, PRIVACY_URL and SUPPORT_EMAIL from deploy/selfhost/.env instead.
# VITE_TERMS_URL=
# VITE_PRIVACY_URL=
# VITE_SUPPORT_EMAIL=

# Join through the public-join Edge Function: turnstile, pow or dev (dev only works with ENVIRONMENT=local on the function).
# Leave empty to call api.join_queue directly.
VITE_PUBLIC_JOIN=

# Dev-only fake SMS inbox at /dev/inbox (also on in `pnpm dev`). Never set for a production build.
VITE_DEV_INBOX=
