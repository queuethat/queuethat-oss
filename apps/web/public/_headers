# Security headers for every response (X-7, #74; technical-design.md section 5).
# Cloudflare Pages reads this file from dist/. `vite preview` serves the same headers, and
# deploy/selfhost/Caddyfile must stay in step (scripts/static-headers.test.ts checks both).
#
# Referrer-Policy is no-referrer everywhere, not only on /q and /v: this is a single-page
# app, so the policy comes from whichever URL the browser loaded first, and a guest who
# lands on / and is routed to /v/<token> would otherwise leak the token in Referer.
#
# The full CSP is enforced (security audit WEB-2). The outside origins are Turnstile and Stripe.js
# (booking payments), plus the Supabase API and Sentry for connect-src. There is no report-to
# endpoint yet (deferred to observability, O6); tests/e2e/csp.spec.ts fails on any violation,
# in Chromium and WebKit. A deployment whose API is not on *.supabase.co (custom domain, self-hosted)
# or whose Sentry DSN is not on *.sentry.io must add that origin to connect-src, or calls are blocked.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://js.stripe.com https://*.js.stripe.com; frame-src https://challenges.cloudflare.com https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com; style-src 'self'; img-src 'self' data: blob: https://*.supabase.co; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.sentry.io https://api.stripe.com; worker-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer

# The service worker must be revalidated on every update check, or new versions stall (O1, #72).
/sw.js
  Cache-Control: no-cache

# Paired TVs and kiosks poll this to notice a new deploy (D3, #50), so it must never be cached.
/version.json
  Cache-Control: no-store

# The embeddable join widget (J7, #245) is the one page meant to sit in someone else's iframe,
# so it drops X-Frame-Options and allows any frame-ancestors. Everything else stays DENY.
# `!` removes a header an earlier rule set (Cloudflare Pages syntax); vercel.json and the
# Caddyfile express the same thing explicitly, and the tests check all three agree.
/w/*
  ! Content-Security-Policy
  ! X-Frame-Options
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://js.stripe.com https://*.js.stripe.com; frame-src https://challenges.cloudflare.com https://js.stripe.com https://*.js.stripe.com https://hooks.stripe.com; style-src 'self'; img-src 'self' data: blob: https://*.supabase.co; font-src 'self'; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.sentry.io https://api.stripe.com; worker-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors *; object-src 'none'; base-uri 'self'
