# Local Edge Function secrets. `cp supabase/functions/.env.example supabase/functions/.env`, then
# `supabase stop && pnpm db:start`: `supabase start` reads this file. Never commit the copy.
#
# DISPATCH_SECRET matches the dispatcher_key that supabase/seeds/01_local_dispatcher.sql puts in
# Vault, so a fresh `pnpm db:reset` sends queued notifications (email lands in Mailpit at
# http://localhost:55324). Production uses its own random secret (docs/ops/pilot-deploy.md).
#
# While this file exists the local dispatcher really runs. tests/e2e/unsubscribe.spec.ts runs its
# own dispatcher over its rows, so remove the copy (and restart) before `pnpm test:e2e`.
DISPATCH_SECRET=local-dispatch-secret-not-for-production
MAILPIT_URL=http://inbucket:8025
PUBLIC_SITE_URL=http://localhost:5173
