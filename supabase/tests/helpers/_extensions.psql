-- Test fixtures a deployment adds for tables and actors of its own (a hosted service). This
-- repository has none. A deployment ships its own copy of this file in place of this one; its
-- tests.create_world_extensions() runs at the end of tests.create_world(), as postgres, and may
-- register extra actors in tests.actors for the RLS matrix (see matrix.<name>.yaml in
-- scripts/compile-rls-matrix.mjs).

create function tests.create_world_extensions() returns void
language plpgsql as $$ begin null; end $$;

/**
 * api functions a deployment adds that signed-in users must not call (service-role jobs and
 * webhooks), beyond the ones tests/contracts/grants.test.sql lists. None here.
 */
create function tests.extension_closed_api_functions() returns text[]
language sql immutable as $$ select '{}'::text[] $$;

/**
 * True in this repository's own build; a deployment's copy of this file returns false. A test uses
 * it only to keep a claim about the absence of hosted features (no plan, no operator console)
 * to the public build, never to skip a behaviour both builds share.
 */
create function tests.is_public_build() returns boolean
language sql immutable as $$ select true $$;
