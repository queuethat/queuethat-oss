          extensions.digest('fixture-invite-token', 'sha256'), tests.id('owner'));

  -- 2A-TM4 (#98) operator switch: the admin's tablet, worked by the staff member
  insert into app.operator_sessions (id, org_id, location_id, device_user_id, operator_user_id, token_hash)
  values (tests.new_id('operator_session_a'), tests.id('org_a'), tests.id('loc_a'), tests.id('admin'),
          tests.id('staff'), extensions.digest('fixture-operator-token', 'sha256'));

  -- PLT6 (#412) entitlements
  insert into app.entitlement_defaults (key, value, description)
  values ('fixture.flag', 'false', 'Test-only flag');
  insert into app.org_entitlements (org_id, key, value, reason)
  values (tests.id('org_a'), 'fixture.flag', 'true', 'fixture');

  -- #1274 a business's own incident log and a notice to its guests
  insert into app.org_incident_log (org_id, source, kind, title, detected_at)
  values (tests.id('org_a'), 'manual', 'other', 'fixture incident log', now());
  insert into app.guest_notices (org_id, log_id, subject, body, window_from, window_to)
  values (tests.id('org_a'), (select id from app.org_incident_log where title = 'fixture incident log'),
          'fixture guest notice', 'fixture body', now() - interval '1 day', now());

  -- What a deployment's own tables and actors need (_extensions.psql; nothing here).
  perform tests.create_world_extensions();
end $$;

------------------------------------------------------------------------------------------------
-- Structural rules (technical-design.md 5). Each returns the offending objects; tests assert
-- the result is empty, so a failure names exactly what broke the rule.
------------------------------------------------------------------------------------------------

/** Schemas we own. Supabase-managed schemas (auth, storage, realtime, ...) are not ours to police. */
create function tests.own_schemas() returns name[]
language sql immutable as $$ select array['api', 'app', 'private', 'ops', 'public']::name[] $$;

/** Schemas PostgREST serves (config.toml [api] schemas, plus public as a tripwire). */
create function tests.exposed_schemas() returns name[]
language sql immutable as $$ select array['api', 'app', 'public']::name[] $$;

create function tests.tables_without_rls() returns setof text
language sql stable as $$
  select format('%I.%I', n.nspname, c.relname)
  from pg_class c join pg_namespace n on n.oid = c.relnamespace
  where c.relkind in ('r', 'p') and n.nspname = any(tests.exposed_schemas())
    and not c.relrowsecurity
  order by 1
$$;

create function tests.tables_without_policies() returns setof text
language sql stable as $$
  select format('%I.%I', n.nspname, c.relname)
  from pg_class c join pg_namespace n on n.oid = c.relnamespace
  where c.relkind in ('r', 'p') and n.nspname = any(tests.exposed_schemas())
    and not exists (select 1 from pg_policy p where p.polrelid = c.oid)
  order by 1
$$;

create function tests.own_functions() returns table (oid oid, signature text, name text)
language sql stable as $$
  select p.oid, p.oid::regprocedure::text, format('%I.%I', n.nspname, p.proname)
  from pg_proc p join pg_namespace n on n.oid = p.pronamespace
  where n.nspname = any(tests.own_schemas())
    and not exists (
      select 1 from pg_depend d
      where d.classid = 'pg_proc'::regclass and d.objid = p.oid and d.deptype = 'e'
    )
$$;

create function tests.definers_without_search_path() returns setof text
language sql stable as $$
  select f.signature
  from tests.own_functions() f join pg_proc p on p.oid = f.oid
  where p.prosecdef
    and not exists (select 1 from unnest(p.proconfig) c where c like 'search_path=%')
  order by 1
$$;

/** SECURITY DEFINER functions anon (directly or via PUBLIC) can execute, minus the allowlist. */
create function tests.anon_definers_not_allowlisted() returns setof text
language sql stable as $$
  select f.signature
  from tests.own_functions() f join pg_proc p on p.oid = f.oid
  where p.prosecdef
    and has_function_privilege('anon', f.oid, 'EXECUTE')
    and f.name <> all(tests.anon_definer_allowlist())
  order by 1
$$;

/** SECURITY DEFINER functions not listed in supabase/security-definer-allowlist.txt at all. */
create function tests.definers_not_allowlisted() returns setof text
language sql stable as $$
  select f.signature
  from tests.own_functions() f join pg_proc p on p.oid = f.oid
  where p.prosecdef and f.name <> all(tests.definer_allowlist())
  order by 1
$$;

create function tests.views_without_security_invoker() returns setof text
language sql stable as $$
  select format('%I.%I', n.nspname, c.relname)
  from pg_class c join pg_namespace n on n.oid = c.relnamespace
  where c.relkind = 'v' and n.nspname = any(tests.own_schemas())
    and not coalesce('security_invoker=true' = any(c.reloptions)
                     or 'security_invoker=on' = any(c.reloptions), false)
  order by 1
$$;

create function tests.matviews_in_exposed_schemas() returns setof text
language sql stable as $$
  select format('%I.%I', n.nspname, c.relname)
  from pg_class c join pg_namespace n on n.oid = c.relnamespace
  where c.relkind = 'm' and n.nspname = any(tests.exposed_schemas())
  order by 1
$$;

/** Any table, view or sequence privilege held by anon or PUBLIC in a schema we own. */
create function tests.anon_relation_grants() returns setof text
language sql stable as $$
  select format('%I.%I: %s', n.nspname, c.relname, a.privilege_type)
  from pg_class c
  join pg_namespace n on n.oid = c.relnamespace
  cross join lateral aclexplode(coalesce(c.relacl, acldefault(
    case when c.relkind = 'S' then 's' else 'r' end::"char", c.relowner))) a
  where n.nspname = any(tests.own_schemas())
    and c.relkind in ('r', 'p', 'v', 'm', 'S', 'f')
    and a.grantee in (0, 'anon'::regrole::oid)
  order by 1
$$;

/** Tables in app without org_id, unless matrix.yaml lists them under global_tables. */
create function tests.tenant_tables_without_org_id() returns setof text
language sql stable as $$
  select format('%I.%I', n.nspname, c.relname)
  from pg_class c join pg_namespace n on n.oid = c.relnamespace
  where c.relkind in ('r', 'p') and n.nspname = 'app'
    and format('%I.%I', n.nspname, c.relname) <> all(tests.global_tables())
    and not exists (
      select 1 from pg_attribute a
      where a.attrelid = c.oid and a.attname = 'org_id' and not a.attisdropped
    )
  order by 1
$$;

/** Tables in exposed schemas with no entry in supabase/tests/rls/matrix.yaml. */
create function tests.tables_without_matrix_entry() returns setof text
language sql stable as $$
  select format('%I.%I', n.nspname, c.relname)
  from pg_class c join pg_namespace n on n.oid = c.relnamespace
  where c.relkind in ('r', 'p') and n.nspname = any(tests.exposed_schemas())
    and format('%I.%I', n.nspname, c.relname) <> all(tests.matrix_tables())
  order by 1
$$;

grant execute on all functions in schema tests to anon, authenticated, service_role;

/**
 * Negative-fixture check: runs p_ddl, then reports whether p_check returns p_expected, and
 * rolls the DDL back. (A SAVEPOINT rollback would also roll back pgTAP's own counters.)
 */
create function tests.catches(p_ddl text, p_check text, p_expected text) returns boolean
language plpgsql as $$
declare caught boolean;
begin
  begin
    execute p_ddl;
    execute format('select %L in (select * from (%s) q)', p_expected, p_check) into caught;
    raise exception using errcode = 'QMPRB', message = caught::text;
  exception when sqlstate 'QMPRB' then
    caught := sqlerrm::boolean;
  end;
  return caught;
end $$;
grant execute on function tests.catches(text, text, text) to anon, authenticated, service_role;
