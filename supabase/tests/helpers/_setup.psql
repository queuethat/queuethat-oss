  -- 2P-RPT4 (#200) export ticket, started by the owner
  insert into app.data_exports (id, org_id, actor, format, idempotency_key, created_at, expires_at)
  values (tests.new_id('export_a'), tests.id('org_a'), tests.id('owner'), 'csv', gen_random_uuid(),
          now() - interval '2 days', now() - interval '2 days' + interval '15 minutes');

