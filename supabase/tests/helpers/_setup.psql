-- Shared pgTAP helpers (F11, #21). Every test file starts with:
--
--   begin;
--   \ir ../helpers/_setup.psql
--   select plan(n);
--   ...
--   select * from finish();
--   rollback;
--
-- The file extension is .psql, not .sql, so pg_prove does not run it as a test. Everything it
-- creates lives in schema `tests` inside the test transaction and is rolled back with it.

create extension if not exists pgtap with schema extensions;
set local search_path = extensions, public;

create schema tests;
grant usage on schema tests to anon, authenticated, service_role;

\ir _generated.psql
\ir _extensions.psql

------------------------------------------------------------------------------------------------
-- Named fixture ids. tests.id('org_a') returns the same uuid every time within a test run.
------------------------------------------------------------------------------------------------
create table tests.ids (name text primary key, id uuid not null default gen_random_uuid());
grant select on tests.ids to anon, authenticated, service_role;

create function tests.id(p_name text) returns uuid
language sql stable as $$
  select id from tests.ids where name = p_name
$$;

create function tests.new_id(p_name text) returns uuid
language sql as $$
  insert into tests.ids (name) values (p_name)
  on conflict (name) do update set name = excluded.name
  returning id
$$;

------------------------------------------------------------------------------------------------
-- Acting as a caller. Each sets the role and JWT claims for the rest of the transaction (or
-- until the next as_* call), exactly as PostgREST would for that request.
------------------------------------------------------------------------------------------------
create function tests.set_claims(p_role text, p_claims jsonb) returns void
language plpgsql as $$
begin
  perform set_config('request.jwt.claims', p_claims::text, true);
  perform set_config('request.jwt.claim.sub', coalesce(p_claims ->> 'sub', ''), true);
  perform set_config('request.jwt.claim.role', p_role, true);
  execute format('set local role %I', p_role);
end $$;

/** Anonymous caller (a guest with no session). */
create function tests.as_anon() returns void
language sql as $$ select tests.set_claims('anon', '{"role":"anon"}') $$;

/** Signed-in user; extra claims are merged into the JWT (e.g. app_metadata). */
create function tests.as_user(p_user_id uuid, p_claims jsonb default '{}') returns void
language sql as $$
  select tests.set_claims(
    'authenticated',
    jsonb_build_object('sub', p_user_id, 'role', 'authenticated', 'aud', 'authenticated') || p_claims
  )
$$;

/** Paired display or kiosk: an auth user whose claims live in app_metadata (technical-design.md 5). */
create function tests.as_device(
  p_user_id uuid, p_kind text, p_org_id uuid, p_location_id uuid, p_scopes text[] default '{}'
) returns void
language sql as $$
  select tests.as_user(p_user_id, jsonb_build_object('app_metadata', jsonb_build_object(
    'kind', p_kind, 'org_id', p_org_id, 'location_id', p_location_id, 'scopes', to_jsonb(p_scopes))))
$$;

/** Edge Functions and the migration runner. */
create function tests.as_service() returns void
language sql as $$ select tests.set_claims('service_role', '{"role":"service_role"}') $$;

/** Back to the superuser the test started as. */
create function tests.as_postgres() returns void
language plpgsql as $$
begin
  reset role;
  perform set_config('request.jwt.claims', '', true);
  perform set_config('request.jwt.claim.sub', '', true);
end $$;

------------------------------------------------------------------------------------------------
-- Actors for the RLS matrix. tests.create_world() (below) fills this with two orgs' users.
------------------------------------------------------------------------------------------------
create table tests.actors (name text primary key, role text not null, claims jsonb not null);

create function tests.act_as(p_actor text) returns void
language plpgsql as $$
declare a tests.actors;
begin
  reset role; -- tests.actors is readable only by the superuser the test started as
  if p_actor = 'anon' then
    perform tests.as_anon();
    return;
  end if;
  select * into a from tests.actors where name = p_actor;
  if not found then
    raise exception 'unknown test actor %, did tests.create_world() run?', p_actor;
  end if;
  perform tests.set_claims(a.role, a.claims);
end $$;

/**
 * Runs p_sql as p_actor and rolls back whatever it changed. p_sql must return one bigint:
 * the number of rows it saw or changed. Returns 'allow' when that is > 0, 'deny' when it is 0
 * or the statement raised insufficient_privilege (42501, which also covers RLS WITH CHECK
 * violations). Any other error propagates so a broken fixture fails loudly.
 */
create function tests.probe(p_actor text, p_sql text) returns text
language plpgsql as $$
declare
  n bigint;
  outcome text;
begin
  begin
    perform tests.act_as(p_actor);
    execute p_sql into n;
    outcome := case when coalesce(n, 0) > 0 then 'allow' else 'deny' end;
    raise exception using errcode = 'QMPRB', message = outcome;
  exception
    when sqlstate 'QMPRB' then outcome := sqlerrm;
    when insufficient_privilege then outcome := 'deny';
  end;
  return outcome;
end $$;

/** Creates an auth user the way GoTrue would, for fixtures. */
create function tests.create_user(p_name text, p_app_metadata jsonb default '{}') returns uuid
language plpgsql as $$
declare uid uuid := tests.new_id(p_name);
begin
  insert into auth.users (id, instance_id, aud, role, email, encrypted_password,
                          raw_app_meta_data, raw_user_meta_data, created_at, updated_at, email_confirmed_at)
  values (uid, '00000000-0000-0000-0000-000000000000', 'authenticated', 'authenticated',
          p_name || '@test.local', '', p_app_metadata, '{}', now(), now(), now());
  return uid;
end $$;

/**
 * Inserts a waiting visit in a fixture queue as the system actor and names it p_name.
 * Ticket numbers come from the real counter; the token hash is random.
 */
create function tests.new_visit(p_name text, p_queue text, p_guest_name text default 'Guest')
returns uuid
language plpgsql as $$
declare
  q app.queues;
  day date;
  n int;
  vid uuid := tests.new_id(p_name);
begin
  select * into q from app.queues where id = tests.id(p_queue);
  day := private.service_day(q.location_id);
  n := private.next_ticket(q.id, q.ticket_prefix, day);
  perform private.set_actor('system', null);
  insert into app.visits (id, org_id, location_id, queue_id, service_day, ticket_prefix, ticket_number,
                          display_ticket, status, sort_key, guest_name, guest_token_hash, source,
                          idempotency_key)
  values (vid, q.org_id, q.location_id, q.id, day, q.ticket_prefix, n,
          q.ticket_prefix || lpad(n::text, 3, '0'), 'waiting', n * 1024, p_guest_name,
          extensions.digest(gen_random_uuid()::text, 'sha256'), 'online', gen_random_uuid());
  return vid;
end $$;

/**
 * An expected visit (an appointment that has not checked in) at p_scheduled, with guest link
 * token p_name || '-token'. It has no place in line until it is checked in.
 */
create function tests.make_expected_visit(p_name text, p_queue text, p_scheduled timestamptz, p_guest_name text default 'Guest')
returns uuid
language plpgsql as $$
declare
  q app.queues;
  day date;
  n int;
  vid uuid := tests.new_id(p_name);
begin
  select * into q from app.queues where id = tests.id(p_queue);
  day := private.service_day(q.location_id);
  n := private.next_ticket(q.id, q.ticket_prefix, day);
  perform private.set_actor('system', null);
  insert into app.visits (id, org_id, location_id, queue_id, service_day, ticket_prefix, ticket_number,
                          display_ticket, status, sort_key, guest_name, guest_token_hash, source,
                          idempotency_key, scheduled_at)
  values (vid, q.org_id, q.location_id, q.id, day, q.ticket_prefix, n,
          q.ticket_prefix || lpad(n::text, 3, '0'), 'expected', n * 1024, p_guest_name,
          private.token_hash(p_name || '-token'), 'appointment', gen_random_uuid(), p_scheduled);
  return vid;
end $$;

/**
 * Builds the shared fixture world and registers its actors for the RLS matrix:
 *   org A ("org_a", location "loc_a") with owner, admin, manager, staff, a display and a kiosk;
 *   org B ("org_b", location "loc_b") with its owner, registered as actor other_owner.
 * Every table migration adds one org A fixture row here so the matrix can probe it. Last, it calls
 * tests.create_world_extensions() (_extensions.psql), where a deployment adds its own actors and rows.
 * Runs as postgres, so RLS does not apply while building.
 */
create function tests.create_world() returns void
language plpgsql as $$
declare
  r text;
  uid uuid;
begin
  insert into app.organizations (id, name) values
    (tests.new_id('org_a'), 'Org A'), (tests.new_id('org_b'), 'Org B');
  insert into app.locations (id, org_id, name, slug, tz) values
    (tests.new_id('loc_a'), tests.id('org_a'), 'Location A', 'test-location-a', 'America/New_York'),
    (tests.new_id('loc_b'), tests.id('org_b'), 'Location B', 'test-location-b', 'Europe/Berlin');

  foreach r in array array['owner', 'admin', 'manager', 'staff'] loop
    uid := tests.create_user(r);
    insert into app.memberships (org_id, user_id, role) values (tests.id('org_a'), uid, r::app.member_role);
    insert into tests.actors values (r, 'authenticated',
      jsonb_build_object('sub', uid, 'role', 'authenticated', 'aud', 'authenticated'));
  end loop;

  uid := tests.create_user('other_owner');
  insert into app.memberships (org_id, user_id, role) values (tests.id('org_b'), uid, 'owner');
  insert into tests.actors values ('other_owner', 'authenticated',
    jsonb_build_object('sub', uid, 'role', 'authenticated', 'aud', 'authenticated'));

  foreach r in array array['display', 'kiosk'] loop
    uid := tests.create_user(r, jsonb_build_object('kind', r, 'org_id', tests.id('org_a'),
                                                   'location_id', tests.id('loc_a')));
    insert into app.devices (id, org_id, location_id, kind, name, auth_user_id)
    values (tests.new_id(r || '_device'), tests.id('org_a'), tests.id('loc_a'), r::app.device_kind, r, uid);
    insert into tests.actors values (r, 'authenticated', jsonb_build_object(
      'sub', uid, 'role', 'authenticated', 'aud', 'authenticated',
      'app_metadata', jsonb_build_object('kind', r, 'org_id', tests.id('org_a'), 'location_id', tests.id('loc_a'))));
  end loop;

  insert into app.business_hours (id, org_id, location_id, weekday, opens, closes)
  values (tests.new_id('hours_a'), tests.id('org_a'), tests.id('loc_a'), 1, '09:00', '17:00');
  insert into app.hours_exceptions (id, org_id, location_id, date, closed)
  values (tests.new_id('exception_a'), tests.id('org_a'), tests.id('loc_a'), '2026-12-25', true);
  insert into app.slug_redirects (old_slug, org_id, location_id)
  values ('old-location-a', tests.id('org_a'), tests.id('loc_a'));

  -- D1 (#48) devices
  insert into app.device_pairing_codes (id, org_id, location_id, kind, code_hash, expires_at)
  values (tests.new_id('pairing_code_a'), tests.id('org_a'), tests.id('loc_a'), 'display',
          extensions.digest('fixture-code', 'sha256'), now() + interval '10 minutes');

  -- 2B-I1 (#306) API keys
  insert into app.api_keys (id, org_id, name, prefix, secret_hash, scopes)
  values (tests.new_id('api_key_a'), tests.id('org_a'), 'Fixture key', '0badc0de',
          extensions.digest('fixture-key', 'sha256'), array['queues:read']);

  -- 3-DOM1 (#370) custom domains
  insert into app.custom_domains (id, org_id, hostname, default_location_id)
  values (tests.new_id('domain_a'), tests.id('org_a'), 'queue.fixture-a.org', tests.id('loc_a'));

  -- 2B-I6 (#311) webhooks
  insert into app.webhook_endpoints (id, org_id, url, event_types, vault_secret_id, active)
  values (tests.new_id('webhook_a'), tests.id('org_a'), 'https://example.com/fixture', array['visit.called'], gen_random_uuid(), false);
  insert into app.webhook_deliveries (id, org_id, endpoint_id, event_id, event_type, payload)
  values (tests.new_id('webhook_delivery_a'), tests.id('org_a'), tests.id('webhook_a'), 'fixture', 'visit.called', '{}');

  -- 3-WA2 (#359) WhatsApp template mapping
  insert into app.notification_templates (id, org_id, trigger, channel, body)
  values (tests.new_id('template_wa'), tests.id('org_a'), 'called', 'whatsapp', 'Your turn {ticket}');
  insert into app.notification_templates (id, org_id, trigger, channel, body)
  values (tests.new_id('template_wa2'), tests.id('org_a'), 'almost_up', 'whatsapp', 'Almost up {ticket}');
  insert into app.whatsapp_templates (id, org_id, template_id, wa_name, wa_language, wa_category, status)
  values (tests.new_id('wa_template_a'), tests.id('org_a'), tests.id('template_wa'), 'queue_called', 'en_US', 'utility', 'approved');

  -- 3-PV1 (#340) provider settings
  insert into app.provider_settings (id, org_id, channel, provider, mode)
  values (tests.new_id('provider_settings_a'), tests.id('org_a'), 'payments', 'stripe', 'own');

  -- 2P-PRV1 (#188) retention
  insert into app.retention_runs (id, org_id, visits_anonymized, contacts_deleted, appointments_anonymized)
  overriding system value values (900000001, tests.id('org_a'), 0, 0, 0);

  -- 2P-PRV5 (#192) block list
  insert into app.blocked_identities (id, org_id, kind, value_hash, reason)
  values (tests.new_id('block_a'), tests.id('org_a'), 'phone_hash', '\xaa', 'fixture');

  -- S2b (#1389) the owner's own phone for test texts
  insert into app.member_phones (id, org_id, user_id, phone_e164, verified_at)
  values (tests.new_id('member_phone_a'), tests.id('org_a'), tests.id('owner'), '+14155550100', now());

  -- S2 (#23) queues
  insert into app.queues (id, org_id, location_id, name, ticket_prefix)
  values (tests.new_id('queue_a'), tests.id('org_a'), tests.id('loc_a'), 'Walk-ins', 'A');
  insert into app.services (id, org_id, location_id, queue_id, name, expected_minutes)
  values (tests.new_id('service_a'), tests.id('org_a'), tests.id('loc_a'), tests.id('queue_a'), 'Haircut', 20);
  -- 4-RBAC1 (#373) custom roles, one per org
  insert into app.custom_roles (id, org_id, name, permissions)
  values (tests.new_id('role_a'), tests.id('org_a'), 'Greeter', array['visits.call']),
         (tests.new_id('role_b'), tests.id('org_b'), 'Greeter', array['visits.call']);
  insert into app.signage_slides (id, org_id, location_id, kind, body)
  values (tests.new_id('slide_a'), tests.id('org_a'), tests.id('loc_a'), 'text', 'Welcome');
  insert into app.counters (id, org_id, location_id, label)
  values (tests.new_id('counter_a'), tests.id('org_a'), tests.id('loc_a'), 'Chair 1');
  insert into app.counters (id, org_id, location_id, label)
  values (tests.new_id('counter_pair'), tests.id('org_a'), tests.id('loc_a'), 'Chair 2');
  insert into app.ticket_counters (org_id, queue_id, prefix, service_day, last_value)
  values (tests.id('org_a'), tests.id('queue_a'), 'A', '2026-01-01', 5);

  -- 2A-Q1 (#100) resources
  insert into app.service_resources (org_id, location_id, service_id, counter_id)
  values (tests.id('org_a'), tests.id('loc_a'), tests.id('service_a'), tests.id('counter_a'));

  -- 2P-APT1 (#157) booking config
  insert into app.services (id, org_id, location_id, queue_id, name, expected_minutes, active)
  values (tests.new_id('service_a2'), tests.id('org_a'), tests.id('loc_a'), tests.id('queue_a'), 'Shave', 15, false);
  insert into app.booking_policies (id, org_id, service_id, bookable)
  values (tests.new_id('booking_policy_a'), tests.id('org_a'), tests.id('service_a'), true);
  insert into app.availability_rules (id, org_id, location_id, weekday, starts, ends)
  values (tests.new_id('availability_rule_a'), tests.id('org_a'), tests.id('loc_a'), 1, '09:00', '17:00');
  insert into app.availability_exceptions (id, org_id, location_id, local_date, kind)
  values (tests.new_id('availability_exception_a'), tests.id('org_a'), tests.id('loc_a'), '2026-12-24', 'unavailable');
  insert into app.time_blocks (id, org_id, location_id, counter_id, during)
  values (tests.new_id('time_block_a'), tests.id('org_a'), tests.id('loc_a'), tests.id('counter_a'),
          tstzrange('2026-12-24 09:00+00', '2026-12-24 10:00+00'));
  insert into app.capacity_rules (id, org_id, service_id, scope, capacity)
  values (tests.new_id('capacity_rule_a'), tests.id('org_a'), tests.id('service_a'), 'slot', 2);

  -- 2B-Q8 (#233) journeys
  insert into app.journeys (id, org_id, location_id, name)
  values (tests.new_id('journey_a'), tests.id('org_a'), tests.id('loc_a'), 'Fixture journey');
  insert into app.journeys (id, org_id, location_id, name)
  values (tests.new_id('journey_b'), tests.id('org_a'), tests.id('loc_a'), 'Empty fixture journey');
  insert into app.journey_steps (id, journey_id, org_id, step_no, queue_id)
  values (tests.new_id('journey_step_a'), tests.id('journey_a'), tests.id('org_a'), 1, tests.id('queue_a'));

  -- 2B-ORG5 (#269) staff shifts
  insert into app.staff_shifts (id, org_id, location_id, user_id, during)
  values (tests.new_id('shift_a'), tests.id('org_a'), tests.id('loc_a'), tests.id('staff'),
          tstzrange('2026-01-01 09:00+00', '2026-01-01 17:00+00'));

  -- 2B-S1 (#271) presence
  -- Stale on purpose: fresh presence would switch the location's ETA to presence counting.
  insert into app.staff_presence (org_id, location_id, user_id, status, since, updated_at)
  values (tests.id('org_a'), tests.id('loc_a'), tests.id('staff'), 'available', now() - interval '13 hours', now() - interval '13 hours');

  -- 2P-APT15 (#171) calendar feeds
  insert into app.calendar_feeds (id, org_id, user_id, token_hash)
  values (tests.new_id('calendar_feed_a'), tests.id('org_a'), tests.id('staff'), extensions.digest('fixture-feed', 'sha256'));

  -- S3 (#24) visits
  perform private.set_actor('system', null);
  perform tests.new_visit('visit_a', 'queue_a');
  -- 2B-Q1 (#226) priority classes
  insert into app.priority_classes (id, org_id, location_id, name, offset_minutes)
  values (tests.new_id('prio_a'), tests.id('org_a'), tests.id('loc_a'), 'Priority', 15);
  insert into app.priority_rules (id, org_id, location_id, priority_class_id, condition_kind, source)
  values (tests.new_id('prule_a'), tests.id('org_a'), tests.id('loc_a'), tests.id('prio_a'), 'source', 'kiosk');
  insert into app.routing_rules (id, org_id, location_id, target_queue_id, active)
  values (tests.new_id('route_a'), tests.id('org_a'), tests.id('loc_a'), tests.id('queue_a'), false);
  -- 2A-Q7 (#106) intake
  insert into app.intake_fields (id, org_id, location_id, queue_id, key, label, type)
  values (tests.new_id('intake_a'), tests.id('org_a'), tests.id('loc_a'), tests.id('queue_a'), 'note', 'Note', 'text');
  insert into app.visit_answers (org_id, location_id, visit_id, answers)
  values (tests.id('org_a'), tests.id('loc_a'), tests.id('visit_a'), '{"note": "hello"}');
  -- F1 (#1277) forms
  insert into app.forms (id, org_id, location_id, name)
  values (tests.new_id('form_a'), tests.id('org_a'), tests.id('loc_a'), 'Form A');
  insert into app.form_versions (id, org_id, location_id, form_id, version, fields, published_at)
  values (tests.new_id('form_version_a'), tests.id('org_a'), tests.id('loc_a'), tests.id('form_a'), 1, '[]', now());
  insert into app.form_targets (id, org_id, location_id, form_id, queue_id, channel)
  values (tests.new_id('form_target_a'), tests.id('org_a'), tests.id('loc_a'), tests.id('form_a'), tests.id('queue_a'), 'booking');
  insert into app.form_responses (id, org_id, location_id, form_version_id, visit_id, answers)
  values (tests.new_id('form_response_a'), tests.id('org_a'), tests.id('loc_a'), tests.id('form_version_a'), tests.id('visit_a'), '{"note": "hello"}');
  -- W2 (#1304) waiver evidence
  insert into app.waiver_acceptances (id, org_id, location_id, form_response_id, form_version_id, field_key, text_hash, accepted_at,
                                      typed_name, subject_kind, subject_id)
  values (tests.new_id('waiver_acceptance_a'), tests.id('org_a'), tests.id('loc_a'), tests.id('form_response_a'), tests.id('form_version_a'),
          'terms', repeat('a', 64), now(), 'Ann Lee', 'visit', tests.id('visit_a'));
  -- 2P-APT2 (#158) appointments
  insert into app.appointments (id, org_id, location_id, service_id, queue_id, starts_at, ends_at, local_date,
                                guest_name, source, idempotency_key)
  values (tests.new_id('appointment_a'), tests.id('org_a'), tests.id('loc_a'), tests.id('service_a'), tests.id('queue_a'),
          '2026-12-21 15:00Z', '2026-12-21 15:20Z', '2026-12-21', 'Ann', 'staff', gen_random_uuid());
  -- 4-APT1 (#385) appointment series
  insert into app.appointment_series (id, org_id, location_id, service_id, rule, idempotency_key)
  values (tests.new_id('series_a'), tests.id('org_a'), tests.id('loc_a'), tests.id('service_a'),
          '{"freq": "weekly", "interval": 1}', gen_random_uuid());
  insert into app.appointment_slot_counts (org_id, service_id, slot_start)
  values (tests.id('org_a'), tests.id('service_a'), '2026-12-21 15:00Z');
  insert into app.appointment_day_counts (org_id, service_id, local_date)
  values (tests.id('org_a'), tests.id('service_a'), '2026-12-21');
  insert into app.idempotency_keys (org_id, actor_id, rpc, key)
  values (tests.id('org_a'), tests.id('staff'), 'call_next', tests.new_id('idem_a'));
  -- 2B-A1 (#276) slot waitlist
  insert into app.slot_waitlist (id, org_id, location_id, service_id, wanted_day, name, guest_email, token_hash, idempotency_key)
  values (tests.new_id('waitlist_a'), tests.id('org_a'), tests.id('loc_a'), tests.id('service_a'), '2030-01-12', 'Fixture',
          'wes@example.test', private.token_hash('tok-waitlist-a'), gen_random_uuid());
  -- 2B-A3 (#278) events
  insert into app.events (id, org_id, location_id, service_id, title, during, capacity, public)
  values (tests.new_id('event_a'), tests.id('org_a'), tests.id('loc_a'), tests.id('service_a'), 'Open day',
          tstzrange('2030-01-12 10:00Z', '2030-01-12 11:00Z'), 10, true);

  -- V2 (#318) payments
  insert into app.payment_holds (id, org_id, provider, provider_hold_id, amount_minor, currency, idempotency_key)
  values (tests.new_id('hold_a'), tests.id('org_a'), 'fake', 'hold_fixture', 500, 'usd', 'fixture');
  insert into app.payment_events (provider, provider_event_id, org_id, type)
  values ('fake', 'evt_fixture', tests.id('org_a'), 'hold_succeeded');

  -- 3-PAY2 (#363) payments
  -- The org's card processor is connected (paid bookings need one).
  update app.provider_settings set enabled = true, verified_at = now() where org_id = tests.id('org_a') and channel = 'payments';
  insert into app.payment_policies (id, org_id, service_id, mode, amount_minor)
  values (tests.new_id('payment_policy_a'), tests.id('org_a'), tests.id('service_a'), 'hold', 500);
  insert into app.payments (id, org_id, location_id, visit_id, provider, intent_id, kind, status, amount_minor, currency, idempotency_key)
  values (tests.new_id('payment_a'), tests.id('org_a'), tests.id('loc_a'), tests.id('visit_a'), 'fake', 'pi_fixture', 'hold', 'authorized', 500, 'usd', 'fixture-pay');
