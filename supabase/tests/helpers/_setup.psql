  insert into app.notifications (id, org_id, visit_id, channel, recipient_ref, template_key,
                                 template_version, dedupe_key)
  values (tests.new_id('notification_a'), tests.id('org_a'), tests.id('visit_a'), 'push',
          tests.id('push_a'), 'called', 1, 'fixture-a');
  insert into app.channel_limits (org_id, channel, daily_cap, country_allowlist)
