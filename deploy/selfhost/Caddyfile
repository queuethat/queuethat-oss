# Security headers for the self-hosted web app (X-7, #74). Keep in step with
# apps/web/public/_headers; apps/web/scripts/static-headers.test.ts fails when they drift.
# The only intended difference is connect-src, which names this install's API origin
# instead of *.supabase.co.
#
# The site block at the end is the one the queue-web image runs (apps/web/Dockerfile); its
# entrypoint sets SITE_ADDRESS, QM_API_ORIGIN and QM_API_WS_ORIGIN from PUBLIC_URL.
(security_headers) {
	header {
		Content-Security-Policy "frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://js.stripe.com; frame-src https://challenges.cloudflare.com https://js.stripe.com https://hooks.stripe.com; style-src 'self'; img-src 'self' data: blob: {$QM_API_ORIGIN}; font-src 'self'; connect-src 'self' {$QM_API_ORIGIN} {$QM_API_WS_ORIGIN} https://*.sentry.io https://api.stripe.com; worker-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; base-uri 'self'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	# The service worker must be revalidated on every update check (O1, #72).
	header /sw.js Cache-Control "no-cache"
	# Paired TVs and kiosks poll this to notice a new deploy (D3, #50); never cache it.
	@version path /version.json
	header @version Cache-Control "no-store"
	# The embeddable join widget (J7, #245) is meant to sit in other sites' iframes.
	@widget path /w/*
	header @widget -X-Frame-Options
	header @widget Content-Security-Policy "frame-ancestors *; object-src 'none'; base-uri 'self'"
	header @widget Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://challenges.cloudflare.com https://js.stripe.com; frame-src https://challenges.cloudflare.com https://js.stripe.com https://hooks.stripe.com; style-src 'self'; img-src 'self' data: blob: {$QM_API_ORIGIN}; font-src 'self'; connect-src 'self' {$QM_API_ORIGIN} {$QM_API_WS_ORIGIN} https://*.sentry.io https://api.stripe.com; worker-src 'self'; manifest-src 'self'; form-action 'self'; frame-ancestors *; object-src 'none'; base-uri 'self'"
}

{
	# Nothing may reconfigure Caddy over the network, and nothing is reported anywhere.
	admin off
	servers {
		# Whose X-Forwarded-For / CF-Connecting-IP to believe. Empty by default: the peer's own
		# address is the client, so nobody can pick the key of the join rate limit. The tunnel
		# profile needs QM_TRUSTED_PROXIES=private_ranges in .env, because cloudflared connects from the
		# compose network and passes the visitor's address in CF-Connecting-IP.
		trusted_proxies static {$QM_TRUSTED_PROXIES}
		client_ip_headers CF-Connecting-IP X-Forwarded-For
	}
}

{$SITE_ADDRESS} {
	import security_headers
	root * /srv
	encode zstd gzip

	# Hashed build files never change; everything an install writes or a deploy replaces does.
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /config.js Cache-Control "no-store"

	# Never served: operator tools that live on other ports or in other products.
	@private path /studio /studio/* /pg /pg/* /project /project/*
	handle @private {
		respond 404
	}

	# The Supabase API on the same hostname, through the gateway (which checks the API key and
	# rate-limits joins). Kong sees one client address, the visitor's, set here and nowhere else:
	# whatever the visitor sent in these headers is replaced.
	@api path /rest/v1/* /auth/v1/* /realtime/v1/* /functions/v1/* /storage/v1/*
	handle @api {
		reverse_proxy kong:8000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Real-IP {client_ip}
			header_up -CF-Connecting-IP
		}
	}

	# Single-page app: any other path is a client route.
	handle {
		try_files {path} /index.html
		file_server
	}
}

# The container's own health check; not published.
http://127.0.0.1:8081 {
	respond /healthz "ok" 200
}
