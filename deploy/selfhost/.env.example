# Every variable the self-host stack reads. `./setup.sh` writes a complete .env from this list with
# fresh secrets; never copy secrets from here, there are none. Mode 600, never commit .env.

## Address
# The public address guests and staff use, no trailing slash. https:// gets a Caddy certificate.
PUBLIC_URL=http://localhost
# Extra auth redirect targets, comma separated (optional).
ADDITIONAL_REDIRECT_URLS=

## Secrets (generated by setup.sh; deploy/selfhost/check-secrets.sh refuses known demo values)
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=3600
# HS256 JWTs signed with JWT_SECRET: role anon / role service_role. Only the anon key reaches the browser.
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
DASHBOARD_PASSWORD=
# Sent by the database as the dispatcher's bearer secret; the dispatch function checks it.
DISPATCH_SECRET=
# 16 characters, encrypts tenant data inside Realtime
REALTIME_DB_ENC_KEY=

## Sign-up and e-mail
# true: only invited people can sign up. Staff invites and sign-in links need working SMTP.
DISABLE_SIGNUP=false
ENABLE_EMAIL_AUTOCONFIRM=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=
SMTP_SENDER_NAME=QueueThat

## Web push (optional; setup.sh generates the pair)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

## Bot protection on online joins (optional, Cloudflare Turnstile secret key)
TURNSTILE_SECRET_KEY=

## Web
# Leave empty to use PUBLIC_URL (an https name gets a certificate). Behind a tunnel that ends TLS: :80
SITE_ADDRESS=
# --profile backup: nightly encrypted dumps into ./backups (docs/selfhost/backups.md)
# age public key to encrypt to (setup.sh --backup-key generates the pair and prints the private key once)
BACKUP_AGE_RECIPIENT=
# How many to keep, the time of day (UTC), a host folder, an optional rclone remote, a Healthchecks URL
BACKUP_KEEP=14
BACKUP_TIME=03:00
BACKUP_PATH=./backups
BACKUP_RCLONE_REMOTE=
BACKUP_HEALTHCHECK_URL=
# true: seed the Demo Barber organization (owner@demo.test and staff@demo.test, password DEMO_PASSWORD)
# and show a "Demo mode" banner. Leave false for a real shop. setup.sh --demo sets both.
DEMO_MODE=false
DEMO_PASSWORD=
# Public site key of Cloudflare Turnstile for sign-in forms (optional)
AUTH_TURNSTILE_SITE_KEY=
# Guest join CAPTCHA: turnstile, pow (no Cloudflare needed) or empty to join directly
PUBLIC_JOIN=
# Error reports from browsers (optional; a Sentry or GlitchTip DSN)
SENTRY_DSN=

# Your own Terms page, privacy notice and support inbox (optional). Guests see the two links
# beside the text-message opt-in and on the join page; staff get a "Contact support" form that
# emails SUPPORT_EMAIL. Left empty, the links and the form are not shown.
TERMS_URL=
PRIVACY_URL=
SUPPORT_EMAIL=

## Profiles
# --profile tunnel: token of a Cloudflare tunnel whose only ingress is http://web:80
TUNNEL_TOKEN=
# With the tunnel: TLS ends at Cloudflare, so Caddy serves plain HTTP and trusts cloudflared for the
# visitor's address. Set SITE_ADDRESS=:80 and QM_TRUSTED_PROXIES=private_ranges (above, in Web).
# ALSO set WEB_BIND=127.0.0.1: private_ranges makes Caddy believe CF-Connecting-IP from any private
# peer, and some Docker setups show public connections with a private source address, which would
# let a guest dodge the join rate limit. cloudflared reaches web over the Docker network, not the port.
WEB_BIND=
QM_TRUSTED_PROXIES=
